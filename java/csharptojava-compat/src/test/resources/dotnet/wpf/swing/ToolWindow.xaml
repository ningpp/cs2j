<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:dotnet.wpf.swing">
    <DockPanel Name="dockPanel">
        <ToolBar DockPanel.Dock="Top">
            <Menu>
                <MenuItem Header="_File">
                    <MenuItem Header="_Open" Command="local:TestCommands.OpenCommand"/>
                </MenuItem>
            </Menu>
            <TextBox Name="_searchBox" Text="Find" Width="156" Height="23"/>
        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBox Name="statusTextBox"/>
        </StatusBar>
        <DockPanel Name="graphViewerPanel" Background="Gray"/>
    </DockPanel>
</Window>
