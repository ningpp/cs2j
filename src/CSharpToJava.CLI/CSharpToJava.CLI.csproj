<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CSharpToJava.Core\CSharpToJava.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cs2jUnsignedMath 支撑库（唯一真源在 src/Cs2jUnsignedMath/，此处嵌入分发） -->
    <EmbeddedResource Include="..\Cs2jUnsignedMath\UnsignedMath.cs">
      <Link>support\Cs2jUnsignedMath\UnsignedMath.cs</Link>
      <LogicalName>Cs2jUnsignedMath.UnsignedMath.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Cs2jUnsignedMath\Cs2jUnsignedMath.csproj">
      <Link>support\Cs2jUnsignedMath\Cs2jUnsignedMath.csproj</Link>
      <LogicalName>Cs2jUnsignedMath.Cs2jUnsignedMath.csproj</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Cs2jArray 支撑库（唯一真源在 src/Cs2jArray/，此处嵌入分发） -->
    <EmbeddedResource Include="..\Cs2jArray\ArrayHelper.cs">
      <Link>support\Cs2jArray\ArrayHelper.cs</Link>
      <LogicalName>Cs2jArray.ArrayHelper.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Cs2jArray\Cs2jArray.csproj">
      <Link>support\Cs2jArray\Cs2jArray.csproj</Link>
      <LogicalName>Cs2jArray.Cs2jArray.csproj</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Cs2jPrelude 支撑库（唯一真源在 src/Cs2jPrelude/，此处嵌入分发） -->
    <EmbeddedResource Include="..\Cs2jPrelude\CsPrelude.cs">
      <Link>support\Cs2jPrelude\CsPrelude.cs</Link>
      <LogicalName>Cs2jPrelude.CsPrelude.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Cs2jPrelude\Cs2jPrelude.csproj">
      <Link>support\Cs2jPrelude\Cs2jPrelude.csproj</Link>
      <LogicalName>Cs2jPrelude.Cs2jPrelude.csproj</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Cs2jRefOutIn 支撑库（唯一真源在 src/Cs2jRefOutIn/，此处嵌入分发） -->
    <EmbeddedResource Include="..\Cs2jRefOutIn\ByRef.cs">
      <Link>support\Cs2jRefOutIn\ByRef.cs</Link>
      <LogicalName>Cs2jRefOutIn.ByRef.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Cs2jRefOutIn\RefStructByRef.cs">
      <Link>support\Cs2jRefOutIn\RefStructByRef.cs</Link>
      <LogicalName>Cs2jRefOutIn.RefStructByRef.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Cs2jRefOutIn\Cs2jRefOutIn.csproj">
      <Link>support\Cs2jRefOutIn\Cs2jRefOutIn.csproj</Link>
      <LogicalName>Cs2jRefOutIn.Cs2jRefOutIn.csproj</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\config\.gitignore">
      <Link>config\.gitignore</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CSharpToJava.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CSharpToJava.ProjectTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <Target Name="RemoveNonEnglishSatelliteAssemblies" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -Command &quot;Get-ChildItem -Path '$(OutputPath)' -Directory -Recurse -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '^[a-z]{2}(-[A-Z]{2})?$' -and $_.Name -ne 'en' -and $_.Name -ne 'bin' -and $_.Name -ne 'obj' -and $_.Name -ne 'ref' } | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue&quot;" />
  </Target>

</Project>
