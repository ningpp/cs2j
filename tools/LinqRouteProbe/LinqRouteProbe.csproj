<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      M0 standalone probe console for C26 (NOT part of CSharpToJavaConverter.slnx).
      M1 promoted the classifier into src/CSharpToJava.Core/LinqChannel; the three
      routing sources are linked here so the tool keeps sharing the single source
      of truth without taking a project reference on the heavyweight Core project.
    -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\CSharpToJava.Core\LinqChannel\LinqHosts.cs"
             Link="LinqHosts.cs" />
    <Compile Include="..\..\src\CSharpToJava.Core\LinqChannel\LinqRoute.cs"
             Link="LinqRoute.cs" />
    <Compile Include="..\..\src\CSharpToJava.Core\LinqChannel\LinqRouteClassifier.cs"
             Link="LinqRouteClassifier.cs" />
  </ItemGroup>

</Project>
