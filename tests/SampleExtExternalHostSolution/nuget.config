<?xml version="1.0" encoding="utf-8"?>
<!-- The test harness rewrites local-feed value to an absolute path after
     copying the fixture (restore runs inside the intermediate tree). -->
<configuration>
  <packageSources>
    <clear />
    <add key="local-feed" value="./local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
